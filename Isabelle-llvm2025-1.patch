index b072d1c..dc2af01 100644
--- a/thys/lib/Float_Setup.thy
+++ b/thys/lib/Float_Setup.thy
@@ -1,5 +1,5 @@
 theory Float_Setup
-imports "Isabelle_LLVM.IICF" "Isabelle_LLVM.IEEE_Bounds"
+imports "Isabelle_LLVM.IICF_Set" "Isabelle_LLVM.IEEE_Bounds"
 begin
 
   lemmas[simp del] = IEEE.round.simps
diff --git a/thys/lib/IEEE_FP_Extensions/IEEE_Bounds.thy b/thys/lib/IEEE_FP_Extensions/IEEE_Bounds.thy
